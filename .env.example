# Gemini (required)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash-lite

# Google OAuth (required for sign-in)
# Get this from https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:8000 and your production domain
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Session JWT (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# Database (required in production)
# Local dev: leave blank or use sqlite:///./tasks.db
# Supabase: use the Transaction pooler URL (port 6543) from Supabase dashboard
DATABASE_URL=
